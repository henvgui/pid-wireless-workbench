# Track the current product and its buildable STM32 examples only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/scripts/
!/archives/
!/ESP32_S3_RGB_Chase/
!/ESP32_S3_Slave_Diagnostic/
!/PID_Shared/
!/PID_Workbench/
!/STM32F103_PA3_HIGH/
!/STM32F103_UART_ECHO/
!/STM32F407_UART_ECHO/

**/.pio/
**/.vscode/
**/.idea/
**/__pycache__/
**/validation/
**/reference/
**/private/
**/build/
**/flash_records/
**/output/
**/tmp/
**/results/
**/*_validation_*.json
/PID_Workbench/PID_Workbench.audit.exe.config
*.pyc
*.pyo
*.exe
*.dll
*.elf
*.axf
*.o
*.a
*.bin
*.hex
*.map
*.zip
*.log
*.bak
*.sqlite3
*.db
*.tmp
*.swp
.env
.env.*
api_token.txt
hosts.yml
.git-credentials
*.pem
*.pfx
*.p12

# Historical desktop snapshots: sanitized source and documents only.
!/archives/desktop-snapshots/
!/archives/desktop-snapshots/*.zip

# Keep the printable manual referenced by the Workbench README.
!/PID_Workbench/output/
/PID_Workbench/output/*
!/PID_Workbench/output/pdf/
/PID_Workbench/output/pdf/*
!/PID_Workbench/output/pdf/PID项目使用手册_V1.2_2026-10-19.pdf

# Hardware maintenance helpers called by the opt-in GUI validation modes.
!/PID_Workbench/validation/
/PID_Workbench/validation/*
!/PID_Workbench/validation/project_audit_hardware_20261024.py
!/PID_Workbench/validation/project_audit_native_20261024.py
!/PID_Workbench/validation/wireless_serial_20261024.py
